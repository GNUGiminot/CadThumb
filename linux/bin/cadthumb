#!/bin/bash
# cadthumb -- install/uninstall/manage CadThumb thumbnails from a terminal.
#
# There is no tray icon on Linux (by design: the file manager itself already caches thumbnails and
# runs extraction out-of-process, see linux/README.md) -- this command is where settings, status and
# (un)install live instead. Run `cadthumb` with no arguments for a quick status + hint.
set -u

# ---------------------------------------------------------------- locate ourselves
SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
VERSION="1.0.1"

find_binary() {
    # 1) already installed alongside this script (post-install layout)
    if [ -x "$SCRIPT_DIR/cadthumb-thumbnailer" ]; then
        echo "$SCRIPT_DIR/cadthumb-thumbnailer"
        return 0
    fi
    # 2) source tree layout: linux/bin/cadthumb + linux/build/cadthumb-thumbnailer
    if [ -x "$SCRIPT_DIR/../build/cadthumb-thumbnailer" ]; then
        echo "$SCRIPT_DIR/../build/cadthumb-thumbnailer"
        return 0
    fi
    # 3) anything already on PATH
    if command -v cadthumb-thumbnailer >/dev/null 2>&1; then
        command -v cadthumb-thumbnailer
        return 0
    fi
    return 1
}

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cadthumb"
SETTINGS_PATH="$CONFIG_DIR/settings.ini"

# ---------------------------------------------------------------- subcommands

cmd_help() {
    cat <<EOF
cadthumb $VERSION -- STEP/3MF/STL thumbnails for Linux file managers

Usage:
  cadthumb                    status + quick hints (default)
  cadthumb status             detailed status: binary, registration, settings
  cadthumb settings           print the settings file path (open it in \$VISUAL/\$EDITOR if set)
  cadthumb install [--system] [--stl]
                               register the thumbnailer (build first: see linux/README.md)
                               --system installs for all users under /usr (needs sudo)
                               --stl    also generate thumbnails for .stl
  cadthumb uninstall [--system] [--purge]
                               remove the registration; --purge also deletes settings
  cadthumb refresh [file]      forget cached thumbnails (all, or just one file) so they regenerate
  cadthumb test <file> [size]  render one thumbnail directly and try to open it (debugging)
  cadthumb help                this text
EOF
}

cmd_status() {
    local bin
    bin="$(find_binary)"
    echo "cadthumb $VERSION"
    if [ -n "$bin" ]; then
        echo "Binary: $bin ($("$bin" --version 2>&1))"
    else
        echo "Binary: not found -- build it first (see linux/README.md), or run 'cadthumb install' from the built source tree"
    fi
    echo "Settings: $SETTINGS_PATH $([ -f "$SETTINGS_PATH" ] && echo '(exists)' || echo '(will be created on first render)')"

    local user_reg="$HOME/.local/share/thumbnailers/cadthumb.thumbnailer"
    local sys_reg="/usr/share/thumbnailers/cadthumb.thumbnailer"
    if [ -f "$user_reg" ]; then
        echo "Registered: per-user ($user_reg)"
        grep -E '^(Exec|MimeType)=' "$user_reg" | sed 's/^/  /'
    elif [ -f "$sys_reg" ]; then
        echo "Registered: system-wide ($sys_reg)"
        grep -E '^(Exec|MimeType)=' "$sys_reg" | sed 's/^/  /'
    else
        echo "Registered: no -- run 'cadthumb install'"
    fi
}

cmd_settings() {
    local bin
    bin="$(find_binary)"
    if [ -n "$bin" ] && [ ! -f "$SETTINGS_PATH" ]; then
        "$bin" --help >/dev/null 2>&1 # side effect: writes the default settings.ini if missing
    fi
    if [ ! -f "$SETTINGS_PATH" ]; then
        mkdir -p "$CONFIG_DIR"
        echo "; run 'cadthumb install' first, or see linux/src/common/Settings.cpp for defaults" > "$SETTINGS_PATH"
    fi
    echo "Settings file: $SETTINGS_PATH"
    local editor="${VISUAL:-${EDITOR:-}}"
    if [ -n "$editor" ] && [ -t 0 ]; then
        exec "$editor" "$SETTINGS_PATH"
    fi
    echo "(set \$VISUAL or \$EDITOR to have this command open it directly)"
    echo "---"
    cat "$SETTINGS_PATH"
}

cmd_refresh() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/thumbnails"
    if [ $# -eq 0 ]; then
        if [ -d "$cache" ]; then
            find "$cache" -mindepth 2 -type f -delete 2>/dev/null
            echo "Cleared cached thumbnails under $cache"
        else
            echo "No thumbnail cache found at $cache (nothing to do)"
        fi
        return 0
    fi
    local uri
    uri="file://$(readlink -f "$1")"
    local hash
    hash="$(printf '%s' "$uri" | md5sum | cut -d' ' -f1)"
    local removed=0
    for size in normal large x-large xx-large fail/cadthumb-thumbnailer; do
        f="$cache/$size/$hash.png"
        [ -f "$f" ] && rm -f "$f" && removed=$((removed + 1))
    done
    echo "Removed $removed cached thumbnail(s) for $1"
}

cmd_test() {
    local file="${1:-}" size="${2:-256}"
    [ -z "$file" ] && {
        echo "usage: cadthumb test <file> [size]" >&2
        exit 2
    }
    local bin
    bin="$(find_binary)" || {
        echo "cadthumb-thumbnailer not found -- build it first (see linux/README.md)" >&2
        exit 1
    }
    local out
    out="$(mktemp --suffix=.png)"
    if "$bin" "$file" "$out" "$size"; then
        echo "Wrote $out"
        command -v xdg-open >/dev/null 2>&1 && xdg-open "$out" >/dev/null 2>&1 &
    else
        rm -f "$out"
        exit 1
    fi
}

cmd_install() {
    local system=0 stl=0
    for a in "$@"; do
        case "$a" in
        --system) system=1 ;;
        --stl) stl=1 ;;
        *)
            echo "unknown option: $a" >&2
            exit 2
            ;;
        esac
    done

    local bin
    bin="$(find_binary)" || {
        echo "cadthumb-thumbnailer not built yet. From the linux/ directory:" >&2
        echo "  cmake -S . -B build && cmake --build build -j\$(nproc)" >&2
        exit 1
    }

    local bin_dir thumb_dir mime_dir as_root=""
    if [ "$system" = 1 ]; then
        bin_dir=/usr/local/bin
        thumb_dir=/usr/share/thumbnailers
        mime_dir=/usr/share/mime/packages
        as_root="sudo"
    else
        bin_dir="$HOME/.local/bin"
        thumb_dir="$HOME/.local/share/thumbnailers"
        mime_dir="$HOME/.local/share/mime/packages"
    fi
    $as_root mkdir -p "$bin_dir" "$thumb_dir" "$mime_dir"
    $as_root install -m 755 "$bin" "$bin_dir/cadthumb-thumbnailer"
    $as_root install -m 755 "$SCRIPT_PATH" "$bin_dir/cadthumb"

    local mimetypes="model/step;application/step;model/3mf;application/vnd.ms-package.3dmanufacturing-3dmodel+xml;"
    [ "$stl" = 1 ] && mimetypes="${mimetypes}model/stl;"
    local thumbnailer_content
    thumbnailer_content="[Thumbnailer Entry]
TryExec=$bin_dir/cadthumb-thumbnailer
Exec=$bin_dir/cadthumb-thumbnailer %u %o %s
MimeType=$mimetypes
"
    printf '%s' "$thumbnailer_content" | $as_root tee "$thumb_dir/cadthumb.thumbnailer" >/dev/null

    local src_mime="$SCRIPT_DIR/../packaging/cadthumb-mime.xml"
    if [ -f "$src_mime" ]; then
        $as_root install -m 644 "$src_mime" "$mime_dir/cadthumb-mime.xml"
        if command -v update-mime-database >/dev/null 2>&1; then
            $as_root update-mime-database "$(dirname "$mime_dir")" >/dev/null 2>&1
        fi
    fi

    echo "Installed $([ "$system" = 1 ] && echo "system-wide" || echo "for the current user")."
    echo "  Binary:       $bin_dir/cadthumb-thumbnailer"
    echo "  Registration: $thumb_dir/cadthumb.thumbnailer"
    [ "$stl" = 1 ] && echo "  .stl thumbnails: enabled" || echo "  .stl thumbnails: disabled (reinstall with --stl to enable)"
    echo
    echo "Open a folder with a .step/.3mf file in your file manager (F5 / reopen the folder if it was"
    echo "already open) or run: cadthumb test <file>"
    if [ "$system" = 0 ]; then
        case ":$PATH:" in
        *":$bin_dir:"*) ;;
        *) echo "Note: $bin_dir is not on your PATH -- add it to run 'cadthumb' directly, or use $bin_dir/cadthumb." ;;
        esac
    fi
}

cmd_uninstall() {
    local system=0 purge=0
    for a in "$@"; do
        case "$a" in
        --system) system=1 ;;
        --purge) purge=1 ;;
        *)
            echo "unknown option: $a" >&2
            exit 2
            ;;
        esac
    done
    local bin_dir thumb_dir mime_dir as_root=""
    if [ "$system" = 1 ]; then
        bin_dir=/usr/local/bin
        thumb_dir=/usr/share/thumbnailers
        mime_dir=/usr/share/mime/packages
        as_root="sudo"
    else
        bin_dir="$HOME/.local/bin"
        thumb_dir="$HOME/.local/share/thumbnailers"
        mime_dir="$HOME/.local/share/mime/packages"
    fi
    $as_root rm -f "$bin_dir/cadthumb-thumbnailer" "$thumb_dir/cadthumb.thumbnailer" "$mime_dir/cadthumb-mime.xml"
    $as_root rm -f "$bin_dir/cadthumb" # the installed copy; source trees live elsewhere
    if command -v update-mime-database >/dev/null 2>&1; then
        $as_root update-mime-database "$(dirname "$mime_dir")" >/dev/null 2>&1
    fi
    echo "Uninstalled $([ "$system" = 1 ] && echo "system-wide" || echo "the per-user") registration."
    if [ "$purge" = 1 ]; then
        rm -rf "$CONFIG_DIR"
        echo "Removed settings ($CONFIG_DIR)."
    fi
}

# ---------------------------------------------------------------- dispatch

case "${1:-}" in
"" | status) cmd_status ;;
settings) cmd_settings ;;
install)
    shift
    cmd_install "$@"
    ;;
uninstall)
    shift
    cmd_uninstall "$@"
    ;;
refresh)
    shift
    cmd_refresh "$@"
    ;;
test)
    shift
    cmd_test "$@"
    ;;
help | --help | -h) cmd_help ;;
--version) echo "cadthumb $VERSION" ;;
*)
    echo "unknown command: $1" >&2
    cmd_help >&2
    exit 2
    ;;
esac
